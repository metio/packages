{:description "A reveal.js converter for Asciidoctor and Asciidoctor.js. Write your slides in AsciiDoc",
 :source {:github "asciidoctor/asciidoctor-reveal.js"}
 :bins {"asciidoctor-revealjs" "{asset}"}
 :tests [["asciidoctor-revealjs" "--version"]]
 :platforms {"linux-x86_64" {:asset "asciidoctor-revealjs-linux-amd64"}
             "linux-aarch64" {:asset "asciidoctor-revealjs-linux-arm64"}
             "darwin-aarch64" {:asset "asciidoctor-revealjs-macos-arm64"}}}
