{:description "Terminal-based email client for Linux and macOS"
 :source {:github "d99kris/nmail"}
 :tests [["nmail" "--version"]]
 :strip 1
 :bins {"nmail" "bin/nmail"}
 :platforms {"linux-x86_64" {:asset "nmail-{version}-linux-x86_64-musl.tar.gz"}
             "linux-aarch64" {:asset "nmail-{version}-linux-arm64-musl.tar.gz"}
             "darwin-aarch64" {:asset "nmail-{version}-macos-arm64.tar.gz"}}}
