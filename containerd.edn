{:description "Container runtime, statically linked, with ctr and the runc shim"
 :source {:github "containerd/containerd"}
 :checksum "{asset}.sha256sum"
 :bins {"containerd" "bin/containerd"
        "containerd-shim-runc-v2" "bin/containerd-shim-runc-v2"
        "containerd-stress" "bin/containerd-stress"
        "ctr" "bin/ctr"}
 :platforms {"linux-x86_64" {:asset "containerd-static-{version}-linux-amd64.tar.gz"}
             "linux-aarch64" {:asset "containerd-static-{version}-linux-arm64.tar.gz"}}}
