{:description "High-performance observability data pipeline for logs, metrics and traces"
 :source {:github "vectordotdev/vector"}
 :tests [["vector" "--version"]]
 :checksum "vector-{version}-SHA256SUMS"
 :strip 2
 :bins {"vector" "bin/vector"}
 :platforms {"linux-x86_64" {:asset "vector-{version}-x86_64-unknown-linux-musl.tar.gz"}
             "linux-aarch64" {:asset "vector-{version}-aarch64-unknown-linux-musl.tar.gz"}
             "darwin-aarch64" {:asset "vector-{version}-arm64-apple-darwin.tar.gz"}}}
