{:description "TUI Application to manage Obsidian notes directly from the terminal"
 :source {:github "erikjuhani/basalt"}
 :tests [["basalt" "--version"]]
 :tag-prefix "basalt/v"
 :strip 1
 :platforms {"linux-x86_64" {:asset "basalt-{version}-x86_64-unknown-linux-musl.tar.gz"}
             "linux-aarch64" {:asset "basalt-{version}-aarch64-unknown-linux-musl.tar.gz"}
             "darwin-x86_64" {:asset "basalt-{version}-x86_64-apple-darwin.tar.gz"}
             "darwin-aarch64" {:asset "basalt-{version}-aarch64-apple-darwin.tar.gz"}}}
