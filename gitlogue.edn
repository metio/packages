{:description "A cinematic Git commit replay tool for the terminal, turning your Git history into a living, animated story."
 :source {:github "unhappychoice/gitlogue"}
 :tests [["gitlogue" "--version"]]
 :platforms {"linux-x86_64" {:asset "gitlogue-v{version}-x86_64-unknown-linux-gnu.tar.gz"}
             "linux-aarch64" {:asset "gitlogue-v{version}-aarch64-unknown-linux-gnu.tar.gz"}
             "darwin-x86_64" {:asset "gitlogue-v{version}-x86_64-apple-darwin.tar.gz"}
             "darwin-aarch64" {:asset "gitlogue-v{version}-aarch64-apple-darwin.tar.gz"}}}
