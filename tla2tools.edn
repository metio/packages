{:description "The TLA+ tools jar with the TLC model checker, SANY and PlusCal, which the command tlc runs on the java of the project; the project links the jar into its bin directory"
 :source {:github "tlaplus/tlaplus"}
 :tests [["tla2tools.jar" "--version"]]
 :verify false
 :asset "tla2tools.jar"
 :bins {"tla2tools.jar" "tla2tools.jar"}
 :commands {"tlc" {:run "exec java -XX:+UseParallelGC -cp {bin}/tla2tools.jar tlc2.TLC \"$@\""
                   :description "The TLC model checker, on the java of the project"}}
 :platforms {"linux-x86_64" {} "linux-aarch64" {} "darwin-x86_64" {} "darwin-aarch64" {}}}
