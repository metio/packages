{:description "A fast, keyboard-driven terminal UI to manage Docker containers, Compose stacks, and Swarm services with the ergonomics of K9s."
 :source {:github "jr-k/d4s"}
 :tests [["d4s" "--version"]]
 :platforms {"linux-x86_64" {:asset "d4s_{version}_linux_amd64.tar.gz"}
             "linux-aarch64" {:asset "d4s_{version}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "d4s_{version}_darwin_amd64.tar.gz"}
             "darwin-aarch64" {:asset "d4s_{version}_darwin_arm64.tar.gz"}}}
