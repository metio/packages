 :platforms {"linux-x86_64" {:asset "lfk_{version}_linux_amd64.tar.gz"}
             "linux-aarch64" {:asset "lfk_{version}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "lfk_{version}_darwin_amd64.zip"}
             "darwin-aarch64" {:asset "lfk_{version}_darwin_arm64.zip"}}}
