             "linux-aarch64" {:asset "tldx_{version}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "tldx_{version}_darwin_amd64.tar.gz"}
             "darwin-aarch64" {:asset "tldx_{version}_darwin_arm64.tar.gz"}}}
