{:source {:github "google/go-jsonnet"},
 :tests [["jsonnet" "--version"]]
 :checksum "checksums.txt",
 :bins {"jsonnet" "jsonnet", "jsonnetfmt" "jsonnetfmt", "jsonnet-lint" "jsonnet-lint", "jsonnet-deps" "jsonnet-deps"},
 :platforms {"linux-x86_64" {:asset "go-jsonnet_{version}_linux_amd64.tar.gz"
                             :history [{:before "0.22.0" :asset "go-jsonnet_Linux_x86_64.tar.gz"}]}
             "linux-aarch64" {:asset "go-jsonnet_{version}_linux_arm64.tar.gz"}
             "darwin-x86_64" {:asset "go-jsonnet_{version}_darwin_amd64.tar.gz"}
             "darwin-aarch64" {:asset "go-jsonnet_{version}_darwin_arm64.tar.gz"}}}
